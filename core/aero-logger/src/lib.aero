// aero-logger
// Minimal logging — no level filtering, no file output.
// If you need that, pipe stdout to a file.

struct LogLevel {
    value: i64,
    label: str,
}

// Could've been one function with a level param, but Aero's generics
// aren't there yet. Separate functions read better at the call site.
fn log_error(msg: str) {
    print("[ERROR] %s\n", msg);
}

fn log_warn(msg: str) {
    print("[WARN]  %s\n", msg);
}

fn log_info(msg: str) {
    print("[INFO]  %s\n", msg);
}

fn log_debug(msg: str) {
    print("[DEBUG] %s\n", msg);
}

// Generic entry — pass the level string yourself
fn log(level: str, msg: str) {
    print("[%s] %s\n", level, msg);
}

fn log_separator() {
    print("---\n");
}

// Indented key=value line, keeps things readable
fn log_kv(key: str, value: str) {
    print("  %s: %s\n", key, value);
}

// Section header with separator lines
fn log_section(title: str) {
    log_separator();
    print("  %s\n", title);
    log_separator();
}