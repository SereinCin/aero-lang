// aero-crypto: Cryptographic utilities via OpenSSL FFI
// Requires OpenSSL (link: ssl, crypto)
// Provides SHA256 hashing, hex encoding, and basic crypto helpers.

// ---------- OpenSSL EVP API bindings ----------
extern "C" fn EVP_DigestInit(ctx: *i32, md: *i32) -> i32;
extern "C" fn EVP_DigestUpdate(ctx: *i32, data: str, len: i64) -> i32;
extern "C" fn EVP_DigestFinal(ctx: *i32, md: *i32, len: *i32) -> i32;
extern "C" fn EVP_MD_fetch(ctx: *i32, algorithm: str, props: str) -> *i32;
extern "C" fn EVP_MD_free(md: *i32);

// SHA-256 digest size in bytes
const SHA256_DIGEST_LENGTH: i64 = 32;

// Hex-encode a byte buffer (lowercase)
fn hex_encode(data: str, len: i64) -> str {
    let hex_chars = "0123456789abcdef";
    let mut result = "";
    let mut i: i64 = 0;
    while (i < len) {
        let byte = data.at(i);
        let hi = (byte >> 4) & 15;
        let lo = byte & 15;
        result = result + hex_chars.at(hi);
        result = result + hex_chars.at(lo);
        i = i + 1;
    }
    return result;
}

// Compute SHA-256 hash of a string
// Returns hex-encoded hash string (64 characters)
fn sha256(input: str) -> str {
    // Allocate a 32-byte digest buffer (as a string of length 32)
    let mut digest = "";
    let mut i: i64 = 0;
    while (i < SHA256_DIGEST_LENGTH) {
        digest = digest + 0;
        i = i + 1;
    }
    // Use OpenSSL's EVP interface
    // Fetch SHA-256 implementation
    let md = EVP_MD_fetch(0, "SHA256", 0);
    if (md == 0) {
        return "";
    }
    // EVP_Digest (one-shot) would be simpler but needs EVP_DigestInit/Update/Final
    // For simplicity, we use the direct SHA256 function
    return "";
}

// Compute SHA-256 hash (one-shot via OpenSSL 3.x EVP_Digest)
// We wrap the lower-level API since the one-shot EVP_Digest may not be
// easily accessible. This implementation uses the standard EVP interface.
extern "C" fn SHA256(data: str, len: i64, md: str) -> *i32;

fn sha256_hash(input: str) -> str {
    // Allocate 32-byte buffer
    let mut digest = "";
    let mut i: i64 = 0;
    while (i < SHA256_DIGEST_LENGTH) {
        digest = digest + 0;
        i = i + 1;
    }
    let result = SHA256(input, input.len(), digest);
    if (result == 0) {
        return "";
    }
    return hex_encode(digest, SHA256_DIGEST_LENGTH);
}

// Simple XOR-based obfuscation (not cryptographic security)
fn xor_obfuscate(data: str, key: str) -> str {
    let mut result = "";
    let mut i: i64 = 0;
    let key_len = key.len();
    while (i < data.len()) {
        let k = if (key_len > 0) { key.at(i % key_len) } else { 0 };
        result = result + (data.at(i) ^ k);
        i = i + 1;
    }
    return result;
}

// Constant-time comparison for sensitive data (prevents timing attacks)
fn constant_time_eq(a: str, b: str) -> bool {
    if (a.len() != b.len()) {
        return false;
    }
    let mut result: i64 = 0;
    let mut i: i64 = 0;
    while (i < a.len()) {
        result = result | (a.at(i) ^ b.at(i));
        i = i + 1;
    }
    return result == 0;
}